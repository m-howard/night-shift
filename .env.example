# Copy to .env for local development. Every variable here is required unless marked optional.

# AWS region the self-hosted runner infrastructure is deployed into. Read by the Pulumi stack and
# by the integration suite, which fails naming this variable rather than skipping without it.
AWS_REGION=us-east-1

# Passphrase Pulumi uses to encrypt secrets in stack configuration. Required by the local file
# backend (`pulumi login --local`) — there is no key management service holding this for you.
PULUMI_CONFIG_PASSPHRASE=

# Optional. Set to point Pulumi at a different backend; unset uses whatever `pulumi login`
# recorded. Example for state kept beside the repo: file://.
# PULUMI_BACKEND_URL=
